<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dev: Laravel `php artisan serve` / LAN IP biasanya HTTP (bukan HTTPS).
         Tanpa ini, request ke IP seperti 192.168.x.x diblokir dan tab Materials error. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
